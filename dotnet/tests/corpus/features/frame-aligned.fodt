<?xml version="1.0" encoding="UTF-8"?>
<office:document
    xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
    xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
    xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
    xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0"
    xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0"
    xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
    xmlns:dc="http://purl.org/dc/elements/1.1/"
    office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text">
 <office:meta>
  <dc:title>Paperless frame alignment</dc:title>
  <dc:subject>Named frame positions against three different reference rectangles</dc:subject>
 </office:meta>
 <office:automatic-styles>
  <style:page-layout style:name="PL">
   <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm"
       fo:margin-left="2cm" fo:margin-right="4cm" fo:margin-top="2cm" fo:margin-bottom="2cm"/>
  </style:page-layout>
  <!-- Centred in the paragraph, which is indented, so it is not centred in the column either. -->
  <style:style style:name="FrPara" style:family="graphic" style:parent-style-name="Frame">
   <style:graphic-properties style:wrap="none" style:number-wrapped-paragraphs="no-limit"
       style:vertical-pos="from-top" style:vertical-rel="paragraph"
       style:horizontal-pos="center" style:horizontal-rel="paragraph"
       fo:margin-left="0cm" fo:margin-right="0cm" fo:margin-top="0cm" fo:margin-bottom="0cm"
       fo:padding-left="0cm" fo:padding-right="0cm" fo:padding-top="0cm" fo:padding-bottom="0cm"
       fo:border="none" fo:background-color="#ccffcc"/>
  </style:style>
  <!-- Against the text area's right edge. -->
  <style:style style:name="FrArea" style:family="graphic" style:parent-style-name="Frame">
   <style:graphic-properties style:wrap="none" style:number-wrapped-paragraphs="no-limit"
       style:vertical-pos="from-top" style:vertical-rel="paragraph"
       style:horizontal-pos="right" style:horizontal-rel="page-content"
       fo:margin-left="0cm" fo:margin-right="0cm" fo:margin-top="0cm" fo:margin-bottom="0cm"
       fo:padding-left="0cm" fo:padding-right="0cm" fo:padding-top="0cm" fo:padding-bottom="0cm"
       fo:border="none" fo:background-color="#ffcccc"/>
  </style:style>
  <!-- Centred on the whole page, which the asymmetric margins put elsewhere than the text area's centre. -->
  <style:style style:name="FrPage" style:family="graphic" style:parent-style-name="Frame">
   <style:graphic-properties style:wrap="none" style:number-wrapped-paragraphs="no-limit"
       style:vertical-pos="from-top" style:vertical-rel="paragraph"
       style:horizontal-pos="center" style:horizontal-rel="page"
       fo:margin-left="0cm" fo:margin-right="0cm" fo:margin-top="0cm" fo:margin-bottom="0cm"
       fo:padding-left="0cm" fo:padding-right="0cm" fo:padding-top="0cm" fo:padding-bottom="0cm"
       fo:border="none" fo:background-color="#ccccff"/>
  </style:style>
 </office:automatic-styles>
 <office:styles>
  <style:style style:name="Body" style:family="paragraph">
   <style:paragraph-properties fo:text-align="start" fo:text-indent="0cm" fo:hyphenate="false"
       fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"
       fo:orphans="0" fo:widows="0"/>
   <style:text-properties style:font-name="Carlito" fo:font-family="Carlito" fo:font-size="11pt"
       fo:language="en" fo:country="GB"/>
  </style:style>
  <style:style style:name="Indented" style:family="paragraph" style:parent-style-name="Body">
   <style:paragraph-properties fo:text-align="start" fo:text-indent="0cm" fo:hyphenate="false"
       fo:margin-left="3cm" fo:margin-right="1cm"
       fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"
       fo:orphans="0" fo:widows="0"/>
   <style:text-properties style:font-name="Carlito" fo:font-family="Carlito" fo:font-size="11pt"
       fo:language="en" fo:country="GB"/>
  </style:style>
 </office:styles>
 <office:master-styles>
  <style:master-page style:name="Standard" style:page-layout-name="PL"/>
 </office:master-styles>
 <office:body><office:text>
   <text:p text:style-name="Indented"><draw:frame draw:style-name="FrPara" draw:name="Centred in the paragraph"
       text:anchor-type="paragraph" svg:x="0cm" svg:y="0.5cm"
       svg:width="3cm" svg:height="1cm" draw:z-index="0">
     <draw:text-box><text:p text:style-name="Body"/></draw:text-box>
    </draw:frame>Centred in an indented paragraph.</text:p>
   <text:p text:style-name="Body">Filler between the frames, at the full width.</text:p>
   <text:p text:style-name="Body">More filler, so the frames do not overlap each other.</text:p>
   <text:p text:style-name="Body"><draw:frame draw:style-name="FrArea" draw:name="Against the text area"
       text:anchor-type="paragraph" svg:x="0cm" svg:y="0.5cm"
       svg:width="3cm" svg:height="1cm" draw:z-index="1">
     <draw:text-box><text:p text:style-name="Body"/></draw:text-box>
    </draw:frame>Held against the text area's right edge.</text:p>
   <text:p text:style-name="Body">Filler between the frames again.</text:p>
   <text:p text:style-name="Body">And more, for the same reason as before.</text:p>
   <text:p text:style-name="Body"><draw:frame draw:style-name="FrPage" draw:name="Centred on the page"
       text:anchor-type="paragraph" svg:x="0cm" svg:y="0.5cm"
       svg:width="3cm" svg:height="1cm" draw:z-index="2">
     <draw:text-box><text:p text:style-name="Body"/></draw:text-box>
    </draw:frame>Centred on the whole page, margins included.</text:p>
   <text:p text:style-name="Body">The last paragraph, clear of every frame.</text:p>
  </office:text></office:body>
</office:document>
