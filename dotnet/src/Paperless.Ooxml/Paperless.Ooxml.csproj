<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Shared Office Open XML infrastructure: DrawingML shapes and geometry, themes and colour transforms, VML, and relationship/part resolution.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The SmartArt layout algorithms place their children by arithmetic with no package around
         them, so they are pinned where they can be called directly rather than through a deck. -->
    <InternalsVisibleTo Include="Paperless.Presentations.Tests" />
    <InternalsVisibleTo Include="Paperless.WordProcessing.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The 187 DrawingML preset shape definitions, reduced from LibreOffice's own
      presetShapeDefinitions.xml. Data rather than code because it *is* data: each preset is a
      list of guide formulas and a list of path commands, and transcribing them into C# would be
      110 kB of literals no one could diff against the file they came from.
    -->
    <EmbeddedResource Include="DrawingML\PresetShapeGeometry.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Paperless.Core\Paperless.Core.csproj" />
    <ProjectReference Include="..\Paperless.Containers\Paperless.Containers.csproj" />
    <ProjectReference Include="..\Paperless.Text\Paperless.Text.csproj" />
    <ProjectReference Include="..\Paperless.Vector\Paperless.Vector.csproj" />
  </ItemGroup>

</Project>
